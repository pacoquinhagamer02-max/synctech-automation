rules_version = '2';
// Regras do servidor do Marca aí. O celular não decide nada sozinho:
// toda leitura e escrita passa por aqui. Preço, código de entrega, horários e
// quem pode ver o quê são conferidos no servidor.
service cloud.firestore {
  match /databases/{db}/documents {

    function logado() { return request.auth != null; }
    function eu() { return request.auth.uid; }
    function novo() { return request.resource.data; }
    function so(campos) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos); }
    function agora() { return request.time.toMillis(); }
    // Horário mandado pelo celular tem que bater com o do servidor (2 min de folga).
    function horaCerta(t) { return t is int && t > agora() - 120000 && t < agora() + 120000; }
    function texto(v, max) { return v is string && v.size() <= max; }
    function geoOk(g) {
      return g == null || (g is map && g.keys().hasOnly(['lat', 'lon']) && g.lat is number && g.lon is number
        && g.lat >= -90 && g.lat <= 90 && g.lon >= -180 && g.lon <= 180);
    }
    // Tabela do Marca aí: R$ 8 até 3 km, R$ 2 por km a mais, R$ 2 de chuva.
    // Volta à loja (maquininha, troco, devolução): a ida vale 1,5 (a chuva não entra na volta).
    // Várias paradas: R$ 3 por entrega além da primeira (o km já é o da rota inteira).
    function freteCerto(km, chuva, volta, paradas, valor) {
      let ida = 8 + (km > 3 ? (km - 3) * 2 : 0);
      let esperado = ida * (volta ? 1.5 : 1.0) + (chuva ? 2 : 0) + (paradas - 1) * 3;
      return valor is number && math.abs(valor - esperado) < 0.011;
    }
    function tokenOk(t) { return t is string && t.matches('^[A-Za-z0-9_-]{22}$'); }
    // Espera paga: 10 min grátis, depois R$ 0,50 por minuto (as regras do Firebase não têm math.max).
    function esperaMaxima(coletou, chegou) {
      let minutos = math.floor((coletou - chegou) / 60000);
      return minutos > 10 ? (minutos - 10) * 0.5 : 0;
    }
    // km do GPS: número, até 500, e nunca menor que o já gravado.
    function kmCresce() {
      return novo().kmReal is number && novo().kmReal <= 500 && novo().kmReal >= resource.data.get('kmReal', 0);
    }
    function chamado(id) { return get(/databases/$(db)/documents/chamados/$(id)).data; }
    // Código certo da parada i (chamado antigo, de uma entrega só, guarda só "valor").
    function codigoDa(id, i) {
      let r = get(/databases/$(db)/documents/chamados/$(id)/restrito/codigo).data;
      return r.get('valores', [r.valor])[i];
    }
    function paradas() { return resource.data.get('nParadas', 1); }
    function feitas() { return resource.data.get('entregues', 0); }
    // O palpite gravado é desta parada e confere com o código dela.
    function palpiteCerto(id) {
      return resource.data.get('codigoParada', 0) == feitas() && resource.data.get('codigoInformado', '') == codigoDa(id, feitas());
    }
    function chamadoDepois(id) { return getAfter(/databases/$(db)/documents/chamados/$(id)).data; }

    match /perfis/{uid} {
      allow read, delete: if logado() && uid == eu();
      allow create, update: if logado() && uid == eu()
        && novo().keys().hasOnly(['papel', 'nome', 'moto', 'placa', 'endereco', 'tel', 'geo', 'plano', 'favoritos'])
        && novo().papel in ['moto', 'empresa'] && texto(novo().nome, 60)
        && texto(novo().get('moto', ''), 40) && texto(novo().get('placa', ''), 10) && texto(novo().get('endereco', ''), 160)
        && texto(novo().get('tel', ''), 20) && geoOk(novo().get('geo', null))
        && novo().get('plano', 'avulso') in ['avulso', 'loja', 'pro']
        && novo().get('favoritos', []) is list && novo().get('favoritos', []).size() <= 30;
    }

    match /chamados/{id} {
      // Aberto: qualquer pessoa logada vê (sem dados do cliente). Depois, só a empresa e o motoboy da corrida.
      allow read: if logado() && (resource.data.status == 'aberto' || resource.data.empresaUid == eu() || resource.data.motoboyUid == eu());

      allow create: if logado()
        && novo().keys().hasOnly(['empresaUid', 'empresa', 'coleta', 'tel', 'lojaGeo', 'bairro', 'km', 'chuva', 'valor', 'taxa', 'obs',
             'status', 'criadoEm', 'motoboyUid', 'preferidosUid', 'prioridadeAte', 'temGeoCliente', 'raioKm', 'cobranca', 'volta',
             'nParadas', 'entregues', 'bairros'])
        && novo().empresaUid == eu() && novo().status == 'aberto' && novo().motoboyUid == null
        && texto(novo().empresa, 60) && novo().empresa.size() > 0 && texto(novo().coleta, 160) && texto(novo().tel, 20)
        && texto(novo().bairro, 60) && texto(novo().obs, 300) && geoOk(novo().lojaGeo)
        && novo().km is number && novo().km >= 0.1 && novo().km <= 100 && novo().chuva is bool
        && novo().get('volta', false) is bool && novo().get('cobranca', 'pago') in ['pago', 'dinheiro', 'maquininha']
        && novo().get('nParadas', 1) is int && novo().get('nParadas', 1) >= 1 && novo().get('nParadas', 1) <= 5
        && novo().get('entregues', 0) == 0
        && novo().get('bairros', []) is list && novo().get('bairros', []).size() <= 5
        && freteCerto(novo().km, novo().chuva, novo().get('volta', false), novo().get('nParadas', 1), novo().valor)
        && novo().taxa is number && novo().taxa >= 0 && novo().taxa <= 10
        && horaCerta(novo().criadoEm) && novo().temGeoCliente is bool
        && novo().get('raioKm', 5) in [3, 5, 8, 15]
        && novo().preferidosUid is list && novo().preferidosUid.size() <= 30
        && (novo().prioridadeAte == null || (novo().prioridadeAte is int && novo().prioridadeAte <= agora() + 60000));

      allow update: if logado() && (
        // Motoboy aceita: só se ainda estiver aberto (o servidor garante que só um consegue).
        (resource.data.status == 'aberto' && novo().status == 'aceito' && novo().motoboyUid == eu()
          && so(['status', 'motoboyUid', 'motoboy', 'moto', 'placa', 'aceitoEm'])
          && horaCerta(novo().aceitoEm) && texto(novo().motoboy, 60) && texto(novo().moto, 40) && texto(novo().placa, 10)
          && (resource.data.preferidosUid.size() == 0 || eu() in resource.data.preferidosUid
              || resource.data.prioridadeAte == null || agora() > resource.data.prioridadeAte))
        // Motoboy chega na loja.
        || (resource.data.motoboyUid == eu() && resource.data.status == 'aceito' && novo().status == 'coleta'
          && so(['status', 'chegouEm', 'chegadaGps', 'kmReal']) && horaCerta(novo().chegouEm) && novo().chegadaGps is bool
          && kmCresce())
        // Motoboy pega o pedido: a espera não pode passar do que o relógio do servidor permite.
        || (resource.data.motoboyUid == eu() && resource.data.status == 'coleta' && novo().status == 'coletado'
          && so(['status', 'coletouEm', 'espera', 'kmReal']) && horaCerta(novo().coletouEm)
          && novo().espera is number && novo().espera >= 0
          && novo().espera <= esperaMaxima(novo().coletouEm, resource.data.chegouEm) + 0.011
          && kmCresce())
        // Motoboy registra um palpite do código (da parada em que está). Fica gravado, então o servidor conta: no máximo 5.
        || (resource.data.motoboyUid == eu() && resource.data.status == 'coletado'
          && so(['codigoInformado', 'tentativas', 'codigoParada']) && novo().get('codigoParada', 0) == feitas()
          && novo().tentativas == resource.data.get('tentativas', 0) + 1
          && novo().tentativas <= 5 && novo().codigoInformado is string && novo().codigoInformado.matches('^[0-9]{4}$'))
        // Motoboy entrega numa parada do meio: só se o palpite gravado bater com o código daquele cliente.
        // As tentativas zeram pra próxima parada.
        || (resource.data.motoboyUid == eu() && resource.data.status == 'coletado' && novo().status == 'coletado'
          && so(['entregues', 'tentativas', 'kmReal', 'paradaEm']) && novo().entregues == feitas() + 1 && novo().entregues < paradas()
          && novo().tentativas == 0 && novo().paradaEm is list && novo().paradaEm.size() == novo().entregues
          && palpiteCerto(id) && kmCresce())
        // Motoboy entrega a última (ou única) parada: só se o último palpite bater com o código guardado (que ele não consegue ler).
        || (resource.data.motoboyUid == eu() && resource.data.status == 'coletado' && novo().status == 'entregue'
          && so(['status', 'entregueEm', 'kmReal', 'entregues']) && horaCerta(novo().entregueEm)
          && feitas() == paradas() - 1 && novo().get('entregues', paradas()) == paradas()
          && palpiteCerto(id) && kmCresce())
        // Empresa libera novas tentativas (depois de conferir o código com o cliente por telefone).
        || (resource.data.empresaUid == eu() && resource.data.status == 'coletado' && so(['tentativas']) && novo().tentativas == 0)
        // Motoboy atualiza o km medido pelo GPS durante a corrida (só pra mais).
        || (resource.data.motoboyUid == eu() && resource.data.status in ['aceito', 'coleta', 'coletado']
          && so(['kmReal']) && novo().kmReal is number && novo().kmReal >= resource.data.get('kmReal', 0) && novo().kmReal <= 500)
        // Motoboy avalia a empresa, uma vez.
        || (resource.data.motoboyUid == eu() && resource.data.status == 'entregue' && resource.data.get('avaliado', false) == false
          && so(['avaliado', 'nota', 'tags']) && novo().avaliado == true && novo().nota is int && novo().nota >= 0 && novo().nota <= 5
          && novo().tags is list && novo().tags.size() <= 6
          && novo().tags.hasOnly(['Pedido estava pronto', 'Atendimento bom', 'Tem onde parar a moto', 'Demorou pra liberar', 'Endereço confuso', 'Me trataram mal']))
        // Empresa cancela: se o motoboy já aceitou, ele recebe R$ 5 de deslocamento.
        || (resource.data.empresaUid == eu() && resource.data.status in ['aberto', 'aceito', 'coleta'] && novo().status == 'cancelado'
          && so(['status', 'canceladoEm', 'compensacao']) && horaCerta(novo().canceladoEm)
          && novo().compensacao == (resource.data.status == 'aberto' ? 0 : 5))
        // Empresa dá gorjeta, uma vez, nos valores do app.
        || (resource.data.empresaUid == eu() && resource.data.status == 'entregue' && resource.data.get('gorjeta', 0) == 0
          && so(['gorjeta']) && novo().gorjeta in [2, 5, 10])
      );
      allow delete: if false;

      // Dados do cliente e código de entrega ficam separados do chamado.
      match /restrito/{doc} {
        allow create: if logado() && chamadoDepois(id).empresaUid == eu() && (
          (doc == 'codigo' && request.resource.data.keys().hasOnly(['valor', 'valores']) && request.resource.data.valor is string
            && request.resource.data.valor.matches('^[0-9]{4}$')
            && request.resource.data.get('valores', [request.resource.data.valor]) is list
            && request.resource.data.get('valores', [request.resource.data.valor]).size() == chamadoDepois(id).get('nParadas', 1)
            && request.resource.data.get('valores', [request.resource.data.valor])[0] == request.resource.data.valor)
          || (doc == 'cliente' && request.resource.data.keys().hasOnly(['entrega', 'cliente', 'telCliente', 'clienteGeo', 'cobrar', 'troco', 'rastreio', 'paradas', 'rastreios'])
            && request.resource.data.get('paradas', []) is list && request.resource.data.get('paradas', []).size() <= 5
            && request.resource.data.get('rastreios', []) is list && request.resource.data.get('rastreios', []).size() <= 5
            && texto(request.resource.data.entrega, 160) && texto(request.resource.data.cliente, 60)
            && texto(request.resource.data.telCliente, 20) && geoOk(request.resource.data.clienteGeo)
            && request.resource.data.get('cobrar', 0) is number && request.resource.data.get('cobrar', 0) >= 0 && request.resource.data.get('cobrar', 0) <= 5000
            && request.resource.data.get('troco', 0) is number && request.resource.data.get('troco', 0) >= 0 && request.resource.data.get('troco', 0) <= 5000
            && (request.resource.data.get('rastreio', '') == '' || tokenOk(request.resource.data.get('rastreio', '')))));
        // Código: só a empresa lê. Cliente: a empresa e o motoboy que aceitou.
        allow read: if logado() && (chamado(id).empresaUid == eu()
          || (doc == 'cliente' && chamado(id).motoboyUid == eu() && chamado(id).status in ['aceito', 'coleta', 'coletado']));
        allow update, delete: if false;
      }

      // Foto da entrega (comprovante), uma por parada, em JPEG pequeno guardado no próprio banco.
      // Só o motoboy da corrida grava (depois de pegar o pedido); só ele e a loja leem.
      match /fotos/{n} {
        allow read: if logado() && (chamado(id).empresaUid == eu() || chamado(id).motoboyUid == eu());
        allow create, update: if logado() && n in ['0', '1', '2', '3', '4']
          && chamado(id).motoboyUid == eu() && chamado(id).status in ['coletado', 'entregue']
          && request.resource.data.keys().hasOnly(['img', 'em']) && horaCerta(request.resource.data.em)
          && request.resource.data.img is string && request.resource.data.img.size() < 350000
          && request.resource.data.img.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$');
        allow delete: if false;
      }
    }

    // Link de rastreio do cliente (como o do iFood Sob Demanda e da Lalamove). O id é um segredo de 132 bits
    // que só vai no link mandado ao cliente: quem tem o link lê; ninguém lista. Sem nome nem telefone do cliente.
    // A empresa cria junto com o chamado; o motoboy da corrida atualiza posição e etapa; a empresa marca cancelado.
    // A etapa gravada aqui tem que ser a mesma do chamado: ninguém mostra "entregue" antes da hora.
    match /rastreios/{token} {
      allow get: if tokenOk(token);
      allow list, delete: if false;
      allow create: if logado() && tokenOk(token)
        && novo().keys().hasOnly(['chamadoId', 'parada', 'empresa', 'lojaGeo', 'destinoGeo', 'status', 'motoboy', 'moto', 'placa', 'pos', 'em'])
        && novo().chamadoId is string && chamadoDepois(novo().chamadoId).empresaUid == eu()
        && novo().get('parada', 0) is int && novo().get('parada', 0) >= 0 && novo().get('parada', 0) < 5
        && (getAfter(/databases/$(db)/documents/chamados/$(novo().chamadoId)/restrito/cliente).data.get('rastreio', '') == token
          || token in getAfter(/databases/$(db)/documents/chamados/$(novo().chamadoId)/restrito/cliente).data.get('rastreios', []))
        && novo().status == 'aberto' && texto(novo().empresa, 60) && geoOk(novo().lojaGeo) && geoOk(novo().destinoGeo)
        && novo().motoboy == '' && novo().moto == '' && novo().placa == '' && novo().pos == null && horaCerta(novo().em);
      // Ao terminar (entregue/cancelado), os pontos da loja e do cliente podem ser apagados (e só isso: nunca trocados).
      allow update: if logado() && so(['status', 'motoboy', 'moto', 'placa', 'pos', 'em', 'lojaGeo', 'destinoGeo']) && horaCerta(novo().em)
        // Etapa igual à da corrida; ou "entregue" pra parada que o motoboy já entregou (a corrida segue pras outras).
        && (novo().status == chamado(resource.data.chamadoId).status
          || (novo().status == 'entregue' && chamado(resource.data.chamadoId).status == 'coletado'
            && chamado(resource.data.chamadoId).get('entregues', 0) > resource.data.get('parada', 0)))
        && (novo().lojaGeo == resource.data.lojaGeo || (novo().lojaGeo == null && novo().status in ['entregue', 'cancelado']))
        && (novo().destinoGeo == resource.data.destinoGeo || (novo().destinoGeo == null && novo().status in ['entregue', 'cancelado']))
        && ((chamado(resource.data.chamadoId).motoboyUid == eu()
              && texto(novo().motoboy, 60) && texto(novo().moto, 40) && texto(novo().placa, 10)
              && (novo().pos == null || (geoOk(novo().pos) && novo().pos != null && novo().status in ['aceito', 'coleta', 'coletado'])))
          || (chamado(resource.data.chamadoId).empresaUid == eu() && novo().status == 'cancelado' && novo().pos == null));
    }

    // Motoboy por turno: a loja reserva um motoboy por algumas horas, com valor por hora garantido.
    // Cancelar depois do aceite paga 1 hora ao motoboy; o valor inteiro sai quando o turno termina.
    match /turnos/{id} {
      allow read: if logado() && (resource.data.status == 'aberto' || resource.data.empresaUid == eu() || resource.data.motoboyUid == eu());
      allow create: if logado()
        && novo().keys().hasOnly(['empresaUid', 'empresa', 'coleta', 'tel', 'lojaGeo', 'obs', 'inicio', 'fim', 'valorHora', 'status', 'criadoEm', 'motoboyUid'])
        && novo().empresaUid == eu() && novo().status == 'aberto' && novo().motoboyUid == null
        && texto(novo().empresa, 60) && novo().empresa.size() > 0 && texto(novo().coleta, 160) && texto(novo().tel, 20) && texto(novo().obs, 300)
        && geoOk(novo().lojaGeo) && horaCerta(novo().criadoEm)
        && novo().inicio is int && novo().fim is int
        && novo().inicio >= agora() - 300000 && novo().inicio <= agora() + 14 * 86400000
        && novo().fim - novo().inicio >= 2 * 3600000 && novo().fim - novo().inicio <= 12 * 3600000
        && novo().valorHora is number && novo().valorHora >= 12 && novo().valorHora <= 60;
      allow update: if logado() && (
        // Motoboy pega o turno: só se ainda estiver aberto e não tiver acabado (o servidor garante que só um consegue).
        (resource.data.status == 'aberto' && novo().status == 'aceito' && novo().motoboyUid == eu() && agora() < resource.data.fim
          && so(['status', 'motoboyUid', 'motoboy', 'moto', 'placa', 'aceitoEm']) && horaCerta(novo().aceitoEm)
          && texto(novo().motoboy, 60) && novo().motoboy.size() > 0 && texto(novo().moto, 40) && texto(novo().placa, 10))
        // Loja desmarca: aberto sai de graça; aceito (e ainda não acabou) paga 1 hora ao motoboy.
        || (resource.data.empresaUid == eu() && novo().status == 'cancelado'
          && (resource.data.status == 'aberto' || (resource.data.status == 'aceito' && agora() < resource.data.fim))
          && so(['status', 'compensacao', 'canceladoEm']) && horaCerta(novo().canceladoEm)
          && novo().compensacao == (resource.data.status == 'aberto' ? 0 : resource.data.valorHora))
        // Turno terminou: a loja ou o motoboy fecha, e o motoboy recebe o valor inteiro.
        || ((resource.data.empresaUid == eu() || resource.data.motoboyUid == eu()) && resource.data.status == 'aceito'
          && novo().status == 'concluido' && agora() >= resource.data.fim
          && so(['status', 'concluidoEm']) && horaCerta(novo().concluidoEm))
      );
      allow delete: if false;
    }

    // Motoboy livre e online: posição APROXIMADA (inteiro em centésimos de grau = grade de ~1 km), sem nome.
    // Serve só pra loja ver quantos motoboys estão perto. Ele mesmo apaga ao ficar offline ou aceitar corrida.
    match /disponiveis/{uid} {
      allow read: if logado();
      allow create, update: if logado() && uid == eu()
        && novo().keys().hasOnly(['latC', 'lonC', 'em'])
        && novo().latC is int && novo().latC >= -9000 && novo().latC <= 9000
        && novo().lonC is int && novo().lonC >= -18000 && novo().lonC <= 18000
        && horaCerta(novo().em);
      allow delete: if logado() && uid == eu();
    }

    // Posição do motoboy: ele grava a dele; só a empresa da corrida em andamento lê.
    match /posicoes/{uid} {
      // Posição que ainda não existe pode ser "escutada" (não revela nada); existente, só pela empresa da corrida.
      allow read: if logado() && (resource == null || resource.data.chamadoId is string && chamado(resource.data.chamadoId).empresaUid == eu()
        && chamado(resource.data.chamadoId).status in ['aceito', 'coleta', 'coletado']);
      allow create, update: if logado() && uid == eu()
        && novo().keys().hasOnly(['lat', 'lon', 'precisao', 'em', 'chamadoId'])
        && novo().lat is number && novo().lon is number && novo().lat >= -90 && novo().lat <= 90 && novo().lon >= -180 && novo().lon <= 180
        && novo().precisao is int && novo().precisao >= 0 && novo().precisao <= 5000 && horaCerta(novo().em)
        && novo().chamadoId is string && chamado(novo().chamadoId).motoboyUid == eu()
        && chamado(novo().chamadoId).status in ['aceito', 'coleta', 'coletado'];
      allow delete: if logado() && uid == eu();
    }
  }
}
